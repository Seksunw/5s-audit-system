#!/bin/sh
# pre-push hook ของ 5S Audit System — ติดตั้ง: cp tools/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# 1) ตรวจกลไกด้วย tools/precheck.py (syntax, i18n, cache-bust, CSP, secret, ไฟล์ต้องห้าม)
# 2) commit ที่จะ push ต้องผ่าน code-checker agent แล้ว (agent เขียน sha ลง .git/code-checker-ok เมื่อผล PASS)
# ฉุกเฉินจริงเท่านั้น (ผู้ใช้สั่งชัดเจน): git push --no-verify
ROOT=$(git rev-parse --show-toplevel)
STAMP="$ROOT/.git/code-checker-ok"
ZERO=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # ลบ branch ฝั่ง remote — ไม่มีโค้ดใหม่
  echo "pre-push: ตรวจ $local_ref ($local_sha)"
  if ! python3 "$ROOT/tools/precheck.py" --ref "$local_sha"; then
    echo "❌ precheck ไม่ผ่าน — แก้รายการ FAIL ด้านบนก่อน push"
    status=1; continue
  fi
  if [ ! -f "$STAMP" ] || ! grep -qx "$local_sha" "$STAMP"; then
    echo "❌ commit $local_sha ยังไม่ผ่านการตรวจของ code-checker agent"
    echo "   ให้ Claude รัน agent code-checker กับ commit นี้ก่อน (ผ่านแล้ว agent จะบันทึกให้เอง)"
    status=1
  fi
done
exit $status
